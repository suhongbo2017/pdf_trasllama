# 视觉大模型配置（复制为 .env 后填写）
# 默认用阿里云百炼的 Qwen-VL，OpenAI 兼容接口，国内直连
VISION_PROVIDER=qwen
DASHSCOPE_API_KEY=

# 其他可选：
# Gemini（需代理）
#   VISION_PROVIDER=gemini
#   GEMINI_API_KEY=AIza...
# OpenAI
#   VISION_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
# 智谱 GLM
#   VISION_PROVIDER=glm
#   ZHIPU_API_KEY=...

# 自定义端点（覆盖预设）
# VISION_BASE_URL=https://xxx/v1
# VISION_MODEL=xxx-vl
# VISION_PROXY=http://127.0.0.1:7897
